{
  "analyzers": {
    "core": {
      "rules": {
        "prefer-unquoted-property-names": {
          "level": "off"
        },
        "use-secure-value-for-secure-inputs": {
          "level": "off"
        }
      }
    }
  },
  "experimentalFeaturesEnabled": {
    "extensibility": true
  },
  "extensions": {
    "radius": "br:biceptypes.azurecr.io/radius:latest"
  }
}
